{
  "name": "moonbase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Moonbase: a co-op fix-it game. One astronaut in VR, mission control on laptops.",
  "scripts": {
    "start": "node server/server.js",
    "test": "node test/game.test.js && node test/hub.test.js",
    "cert": "mkdir -p certs && openssl req -x509 -newkey rsa:2048 -nodes -keyout certs/key.pem -out certs/cert.pem -days 30 -subj \"/CN=moonbase\"",
    "smoke": "node test/smoke.mjs",
    "music": "node test/music.mjs",
    "smoke:shots": "SMOKE_SHOTS=1 node test/smoke.mjs",
    "vr": "node test/vr.mjs",
    "vr:sample": "node test/vr-sample.mjs",
    "vr:shots": "VR_SHOTS=1 node test/vr.mjs",
    "assets": "node test/assets.mjs",
    "assets:shots": "ASSET_SHOTS=1 node test/assets.mjs",
    "avatar": "node test/avatar.mjs",
    "avatar:shots": "AVATAR_SHOTS=1 node test/avatar.mjs",
    "camviews": "node test/camviews.mjs",
    "camviews:shots": "CAMVIEW_SHOTS=1 node test/camviews.mjs",
    "keypick": "node test/keypick.mjs",
    "bake": "node scripts/bake-assets.mjs",
    "dev:cf": "wrangler dev",
    "deploy": "wrangler deploy",
    "vendor": "node scripts/vendor-three.mjs",
    "debrief": "node test/debrief.mjs",
    "trailer": "node scripts/trailer/record.mjs && node scripts/trailer/assemble.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.180.0",
    "wrangler": "^4.162.0"
  }
}
